<Window x:Class="RootedAndroidGameVM.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 Rooted Android Game VM" Width="940" Height="650" MinWidth="860" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Segoe UI" Foreground="{StaticResource InkBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#172033">
            <Grid Margin="36,36,34,34">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="48" Height="48" Background="#5865F2" CornerRadius="13" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Rooted Android&#x0a;Game VM" Foreground="White" FontSize="24" FontWeight="SemiBold" LineHeight="31" Margin="0,18,0,0" />
                    <TextBlock Text="一次安装，之后从桌面直接启动。" Foreground="#BFC7D7" FontSize="13" Margin="0,10,0,0" />
                </StackPanel>
                <ItemsControl x:Name="StageList" Grid.Row="2">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,19">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#2B354A" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Number}" Foreground="#CBD2E0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Caption}" Foreground="#9FA9BC" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="3" Text="Windows 11 x64 · Android 15 · Root" Foreground="#8792A6" FontSize="11" />
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="46,40,46,38">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="28" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="安装到这台电脑" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="安装器将自动准备安卓运行环境、创建虚拟机并验证 Root 权限。" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,9,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Row="2" Background="#F6F7FB" CornerRadius="14" Padding="22,20">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="ProgressTitleText" Text="准备安装" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProgressDetailText" Text="点击“开始安装”后，所有操作都会在后台完成。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                    <ProgressBar x:Name="InstallProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,18,0,0" BorderThickness="0" Foreground="{StaticResource AccentBrush}" Background="#E3E7EF" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="3" Margin="0,25,0,0">
                <TextBlock Text="安装内容" FontSize="14" FontWeight="SemiBold" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#168A64" FontSize="14" />
                    <TextBlock Grid.Column="1" Text="Android Emulator 与必要的 SDK 组件" FontSize="13" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#168A64" FontSize="14" />
                    <TextBlock Grid.Column="1" Text="拥有 Root 权限的 Android 虚拟设备" FontSize="13" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#168A64" FontSize="14" />
                    <TextBlock Grid.Column="1" Text="桌面启动器、APK 安装与数据导出工具" FontSize="13" />
                </Grid>
                <TextBlock Text="不会附带任何商业 APK、账号数据或游戏谱面。" Foreground="#8A94A6" FontSize="11" Margin="0,24,0,0" TextWrapping="Wrap" />
                <StackPanel Margin="0,18,0,0">
                    <CheckBox x:Name="LicenseCheckBox" VerticalContentAlignment="Center">
                        <TextBlock Text="我已阅读并接受 Android SDK 许可协议，允许安装器下载所需组件。" FontSize="12" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Margin="24,6,0,0" FontSize="11">
                        <Hyperlink NavigateUri="https://developer.android.com/studio/terms"
                                   RequestNavigate="LicenseLink_RequestNavigate">在浏览器中查看 Android SDK 许可协议</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="4">
                <Button x:Name="ExitButton" Style="{StaticResource SecondaryButton}" Content="退出" Width="88" HorizontalAlignment="Left" Click="Exit_Click" />
                <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="开始安装" Width="126" HorizontalAlignment="Right" Click="Install_Click" AutomationProperties.Name="开始安装" />
            </Grid>
        </Grid>
    </Grid>
</Window>
