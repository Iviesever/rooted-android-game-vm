<Window x:Class="RootedAndroidGameVM.Launcher.DebugWorkbench"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="调试工作台 · Rooted Android Game VM 0.3.0" Width="1280" Height="850" MinWidth="1000" MinHeight="700"
 Background="{StaticResource PageBrush}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE2ED"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF0FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/></Style>
 </Window.Resources>
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="安卓调试工作台" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="仅控制本产品的虚拟机。预览用于观察和输入定位，正常游玩请使用模拟器窗口。" Foreground="#697386" Margin="0,6,0,12"/>
   <WrapPanel>
    <Button Content="启动" Tag="start" Click="Command_Click"/><Button Content="停止并保存" Tag="stop" Click="Command_Click"/>
    <Button Content="刷新状态" Tag="status" Click="Command_Click"/><Button Content="唤醒" Tag="wake" Click="Command_Click"/>
    <Button Content="取消当前任务" Click="Cancel_Click"/><Button Content="释放全部触点" Tag="release" Click="Command_Click"/>
    <Button Content="打开记录目录" Click="OpenRecords_Click"/>
   </WrapPanel>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Text="准备就绪" TextWrapping="Wrap" Margin="4,10"/>
  <TabControl>
   <TabItem Header="屏幕与输入">
    <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
     <Border Background="#111827" CornerRadius="8" Margin="0,0,12,0"><Image x:Name="Preview" Stretch="Uniform" MouseMove="Preview_MouseMove" MouseLeftButtonDown="Preview_Down" MouseLeftButtonUp="Preview_Up"/></Border>
     <StackPanel Grid.Column="1">
      <Button Content="获取原始截图" Tag="screen" Click="Command_Click"/>
      <TextBlock x:Name="CoordinateText" Text="先截图，再在预览上点击或拖动。" TextWrapping="Wrap" Margin="6"/>
      <TextBlock x:Name="ScreenInfo" TextWrapping="Wrap" Margin="6"/>
      <WrapPanel><Button Content="返回" Tag="KEYCODE_BACK" Click="Key_Click"/><Button Content="主页" Tag="KEYCODE_HOME" Click="Key_Click"/></WrapPanel>
      <TextBlock Text="剪贴板" Margin="6,18,6,0"/><TextBox x:Name="ClipboardText" Height="100" TextWrapping="Wrap" AcceptsReturn="True"/>
      <WrapPanel><Button Content="写入安卓" Click="SetClipboard_Click"/><Button Content="读取安卓" Click="GetClipboard_Click"/></WrapPanel>
      <TextBlock Text="点击：按下后松开。长按：停留后松开。滑动：拖动后松开。多指序列请使用“测试与检查点”页。" TextWrapping="Wrap" Foreground="#697386" Margin="6,18"/>
     </StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="应用与文件">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <WrapPanel><TextBlock Text="应用包名" VerticalAlignment="Center"/><TextBox x:Name="PackageText" Text="me.mugzone.emiria" Width="260"/>
       <Button Content="应用列表" Tag="apps" Click="Command_Click"/><Button Content="启动应用" Tag="launch" Click="Command_Click"/><Button Content="停止应用" Tag="force-stop" Click="Command_Click"/>
       <Button Content="安装 / 更新 APK…" Click="Install_Click"/><ComboBox x:Name="AppsBox" Width="220" Margin="4" SelectionChanged="Apps_Changed" ToolTip="选择应用"/>
      </WrapPanel>
      <WrapPanel><Button Content="导入 Malody 皮肤 / 谱面…" Click="Import_Click"/><Button Content="部署并重新加载…" Click="Reload_Click"/></WrapPanel>
     </StackPanel>
     <StackPanel Grid.Row="1">
      <Separator Margin="0,12"/>
      <WrapPanel><TextBlock Text="文件范围" VerticalAlignment="Center"/><ComboBox x:Name="ScopeBox" SelectedIndex="0" Width="190" Margin="8"><ComboBoxItem Content="外部专属目录" Tag="external"/><ComboBoxItem Content="应用私有目录（Root）" Tag="private"/><ComboBoxItem Content="共享 Download" Tag="shared"/></ComboBox>
       <TextBlock Text="相对路径" VerticalAlignment="Center"/><TextBox x:Name="RemoteText" Width="400" Text="files"/>
      </WrapPanel>
      <WrapPanel><Button Content="浏览目录" Tag="files.list" Click="FileCommand_Click"/><Button Content="下载文件…" Click="Download_Click"/><Button Content="上传文件…" Click="Upload_Click"/>
       <Button Content="比较本地目录…" Tag="files.diff" Click="Folder_Click"/><Button Content="同步本地目录…" Tag="files.sync" Click="Folder_Click"/>
      </WrapPanel>
      <TextBlock Text="上传时填写完整目标文件名。私有目录写入前先停止应用。覆盖保留备份；同步保留目标额外文件。" Foreground="#697386" Margin="4,4,0,10"/>
     </StackPanel>
     <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="140"/></Grid.RowDefinitions>
      <DataGrid x:Name="FileGrid" IsReadOnly="True" AutoGenerateColumns="True" MouseDoubleClick="FileGrid_DoubleClick" Margin="4"/>
      <TextBox Grid.Row="1" x:Name="FileOutput" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="日志与诊断">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <WrapPanel><TextBlock Text="采集秒数" VerticalAlignment="Center"/><TextBox x:Name="SecondsText" Text="30" Width="70"/>
       <Button Content="持续应用日志" Tag="logs" Click="Diagnostic_Click"/><Button Content="内存 / CPU / 帧信息" Tag="metrics" Click="Diagnostic_Click"/>
       <Button Content="录屏（无音频）" Tag="record" Click="Diagnostic_Click"/><Button Content="系统追踪" Tag="trace" Click="Diagnostic_Click"/>
      </WrapPanel>
      <WrapPanel><TextBlock Text="过滤文本" VerticalAlignment="Center"/><TextBox x:Name="LogFilter" Width="280" TextChanged="Filter_Changed"/>
       <Button Content="异常 / 崩溃 / ANR" Click="Errors_Click"/></WrapPanel>
     </StackPanel>
     <TextBox x:Name="LogOutput" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="测试与检查点">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <WrapPanel><Button Content="停机并建立检查点" Tag="checkpoint.create" Click="Command_Click"/><Button Content="列出检查点" Tag="checkpoint.list" Click="Command_Click"/>
       <TextBox x:Name="CheckpointId" Width="260" ToolTip="检查点编号"/><Button Content="恢复此检查点" Click="Restore_Click"/><Button Content="恢复中断操作" Tag="checkpoint.recover" Click="Command_Click"/></WrapPanel>
      <TextBlock Text="检查点包含应用数据和密钥，请妥善保管。恢复前会保留当前磁盘作为回退副本。" Foreground="#697386" Margin="6"/>
      <WrapPanel><Button Content="填入六指测试模板" Click="Template_Click"/><Button Content="打开测试 JSON…" Click="OpenTest_Click"/><Button Content="运行编辑器请求" Click="RunTest_Click"/></WrapPanel>
     </StackPanel>
     <TextBox x:Name="TestEditor" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="Shell 调试">
    <DockPanel Margin="12"><WrapPanel DockPanel.Dock="Top"><Button Content="普通 Shell" Tag="shell" Click="Shell_Click"/><Button Content="Root Shell" Tag="root-shell" Click="Shell_Click"/><TextBlock Text="命令始终发给经过校验的产品虚拟机。" VerticalAlignment="Center"/></WrapPanel>
     <TextBox x:Name="ShellEditor" Text="getprop ro.product.cpu.abilist" Height="120" DockPanel.Dock="Top" AcceptsReturn="True" FontFamily="Consolas"/>
     <TextBox x:Name="ShellOutput" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
