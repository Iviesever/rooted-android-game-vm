<Window x:Class="RootedAndroidGameVM.Launcher.StorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="资源位置" Width="790" Height="660" MinWidth="680" MinHeight="590"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}" FontFamily="Segoe UI" Foreground="{StaticResource InkBrush}">
    <DockPanel Margin="30">
        <Grid DockPanel.Dock="Bottom" Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="CloseButton" Content="关闭" Style="{StaticResource ActionCardButton}" Padding="22,10" Click="Close_Click" />
                <Button x:Name="CancelButton" Content="取消迁移" Style="{StaticResource ActionCardButton}" Padding="18,10" Margin="10,0,0,0" Click="Cancel_Click" Visibility="Collapsed" />
            </StackPanel>
            <Button x:Name="MoveButton" Content="开始迁移" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="140" Click="Move_Click" IsEnabled="False" AutomationProperties.Name="开始迁移资源" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="资源位置" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="管理模拟器、下载缓存与应用数据占用的磁盘空间。" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                <Border Background="White" CornerRadius="14" Padding="20" Margin="0,22,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="当前位置" FontSize="14" FontWeight="SemiBold" />
                        <TextBox x:Name="CurrentPathTextBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="13" Margin="0,10,0,0" MaxHeight="65" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="当前资源位置" />
                        <TextBlock x:Name="CurrentSizeText" Text="正在计算资源大小…" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="迁移到" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetPathTextBox" Padding="10" FontSize="13" VerticalContentAlignment="Center" BorderBrush="#D6DCE6" BorderThickness="1" TextChanged="TargetPath_Changed" AutomationProperties.Name="迁移目标文件夹" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" Style="{StaticResource ActionCardButton}" Padding="18,9" Margin="10,0,0,0" Click="Browse_Click" AutomationProperties.Name="选择迁移目标" />
                </Grid>
                <TextBlock Text="选择其他磁盘上的空文件夹。迁移时会关闭模拟器，校验和启动验证通过后释放原磁盘空间。以后启动、更新与修复都会使用新位置。" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                <Border Background="#EBEDF9" CornerRadius="12" Padding="18" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ProgressTitleText" Text="准备迁移" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="ProgressDetailText" Text="原始资源会保留到新位置验证完成。" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <ProgressBar x:Name="TransferProgressBar" Minimum="0" Maximum="100" Height="7" Foreground="{StaticResource AccentBrush}" Background="#D8DDF0" BorderThickness="0" Margin="0,14,0,0" />
                        <TextBlock x:Name="ProgressBytesText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Button x:Name="RecoverButton" Content="恢复上次迁移" Style="{StaticResource ActionCardButton}" Padding="14,11" Margin="0,14,0,0" HorizontalAlignment="Left" Visibility="Collapsed" Click="Recover_Click" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
