<Window x:Class="RootedAndroidGameVM.Launcher.Workstation.TransferResultsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="传输结果与备份记录" Width="900" Height="650" MinWidth="650" MinHeight="480" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="#F3F5F9">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.AutomationId="Transfer.Summary"/>
  <DataGrid x:Name="ResultsTable" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="Selection_Changed" AutomationProperties.AutomationId="Transfer.Results">
   <DataGrid.Columns><DataGridTextColumn Header="目标文件或文件夹" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="结果" Binding="{Binding Status}" Width="130"/></DataGrid.Columns>
  </DataGrid>
  <TextBox x:Name="DetailsText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10" AutomationProperties.Name="所选项目的问题、暂存与备份"/>
  <DockPanel Grid.Row="3"><Button x:Name="MoreButton" Content="加载下一页" Click="More_Click" DockPanel.Dock="Right" Padding="14,7"/><TextBlock x:Name="CountText" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
