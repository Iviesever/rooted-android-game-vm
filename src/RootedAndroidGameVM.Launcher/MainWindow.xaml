<Window x:Class="RootedAndroidGameVM.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rooted Android Game VM" Width="1080" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI" Foreground="{StaticResource InkBrush}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid Margin="38,28,38,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="Auto" />
            <RowDefinition Height="28" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="46" Height="46" Background="#172033" CornerRadius="12">
                <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,1,0,0">
                <TextBlock Text="Rooted Android Game VM" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="拥有 Root 权限的通用安卓游戏环境" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource ActionCardButton}" Padding="13,8" Click="OpenSettings_Click" ToolTip="打开设置" AutomationProperties.Name="打开设置">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,1,8,0" /><TextBlock Text="设置" FontSize="14" /></StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="2" Background="#172033" CornerRadius="18" Padding="26,24">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#8A94A6" Margin="0,2,9,0" /><TextBlock Text="虚拟机状态" Foreground="#BFC7D7" FontSize="13" /></StackPanel>
                    <TextBlock x:Name="StatusTitleText" Text="正在检查…" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock x:Name="StatusDetailText" Text="正在检查本机安装状态。" Foreground="#C9D0DE" FontSize="14" Margin="0,7,0,0" />
                </StackPanel>
                <Button x:Name="PrimaryActionButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" MinWidth="138"
                        Click="PrimaryAction_Click" AutomationProperties.Name="虚拟机主要操作" VerticalAlignment="Center" Content="请稍候" />
            </Grid>
        </Border>
        <TextBlock Grid.Row="4" Text="常用操作" FontSize="17" FontWeight="SemiBold" />
        <UniformGrid Grid.Row="5" Columns="3" Rows="2" Margin="0,15,0,20">
            <Button Style="{StaticResource ActionCardButton}" Margin="0,0,12,12" Tag="StartOrStop" Click="ActionCard_Click" AutomationProperties.Name="启动或停止虚拟机">
                <StackPanel><Border Width="38" Height="38" CornerRadius="10" Background="#EEF0FF" HorizontalAlignment="Left"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="启动 / 停止" FontSize="15" FontWeight="SemiBold" Margin="0,15,0,0" /><TextBlock Text="控制安卓虚拟机" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" /></StackPanel>
            </Button>
            <Button Style="{StaticResource ActionCardButton}" Margin="0,0,12,12" Tag="InstallApk" Click="ActionCard_Click" AutomationProperties.Name="安装或更新 APK">
                <StackPanel><Border Width="38" Height="38" CornerRadius="10" Background="#EAF8F3" HorizontalAlignment="Left"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="#168A64" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="安装或更新 APK" FontSize="15" FontWeight="SemiBold" Margin="0,15,0,0" /><TextBlock Text="选择本机 APK 文件" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" /></StackPanel>
            </Button>
            <Button Style="{StaticResource ActionCardButton}" Margin="0,0,0,12" Tag="AppsAndData" Click="ActionCard_Click" AutomationProperties.Name="应用与数据">
                <StackPanel><Border Width="38" Height="38" CornerRadius="10" Background="#FFF3E7" HorizontalAlignment="Left"><TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="#C8711E" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="应用与数据" FontSize="15" FontWeight="SemiBold" Margin="0,15,0,0" /><TextBlock Text="启动应用、浏览或导出数据" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" /></StackPanel>
            </Button>
            <Button Style="{StaticResource ActionCardButton}" Margin="0,0,12,0" Tag="Settings" Click="ActionCard_Click" AutomationProperties.Name="性能设置">
                <StackPanel><Border Width="38" Height="38" CornerRadius="10" Background="#F3EEFF" HorizontalAlignment="Left"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="#7652C9" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="性能设置" FontSize="15" FontWeight="SemiBold" Margin="0,15,0,0" /><TextBlock Text="调整画质、内存与窗口" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" /></StackPanel>
            </Button>
            <Button Style="{StaticResource ActionCardButton}" Margin="0,0,12,0" Tag="Diagnostics" Click="ActionCard_Click" AutomationProperties.Name="诊断">
                <StackPanel><Border Width="38" Height="38" CornerRadius="10" Background="#EAF5FF" HorizontalAlignment="Left"><TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="#3178B8" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="诊断" FontSize="15" FontWeight="SemiBold" Margin="0,15,0,0" /><TextBlock Text="检查 ADB、Root 与运行环境" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" /></StackPanel>
            </Button>
            <Button Style="{StaticResource ActionCardButton}" Tag="Repair" Click="ActionCard_Click" AutomationProperties.Name="修复">
                <StackPanel><Border Width="38" Height="38" CornerRadius="10" Background="#FDEFF0" HorizontalAlignment="Left"><TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="#B94D59" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="修复" FontSize="15" FontWeight="SemiBold" Margin="0,15,0,0" /><TextBlock Text="修复虚拟机或重新配置 Root" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" /></StackPanel>
            </Button>
        </UniformGrid>
        <Grid Grid.Row="6"><TextBlock x:Name="FooterStatusText" Text="准备就绪" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="版本 0.1.0 · 本地运行" Foreground="#929BAD" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
    </Grid>
</Window>
