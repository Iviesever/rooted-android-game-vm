<Window x:Class="RootedAndroidGameVM.Launcher.WorkstationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:RootedAndroidGameVM.Launcher.Workstation"
 Title="Rooted Android Game VM" Width="1320" Height="900" MinWidth="1080" MinHeight="740"
 FontFamily="Segoe UI" FontSize="14" Foreground="#172033" Background="#F3F5F9"
 WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
 <Window.Resources>
  <local:SectionVisibility x:Key="SectionVisibility"/><BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="Button" x:Key="ToolButton">
   <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="15,9"/><Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DCE2EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#EDF1FF"/><Setter Property="Foreground" Value="#172033"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource ToolButton}"/>
  <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource ToolButton}"><Setter Property="Background" Value="#4355D9"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4355D9"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DCE2EC"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF0F5"/><Setter Property="BorderBrush" Value="#E0E6F0"/><Setter Property="RowHeight" Value="40"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="EnableRowVirtualization" Value="True"/></Style>
  <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E1E6F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
  <Style TargetType="TextBlock" x:Key="Label"><Setter Property="Foreground" Value="#68758B"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
  <Style TargetType="TextBlock" x:Key="Heading"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,15"/></Style>
 </Window.Resources>
 <Grid Background="#F3F5F9">
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#121B2D" Padding="18,25,18,20">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,28"><TextBlock Text="ANDROID" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="GAME WORKSTATION" Foreground="#8192B5" FontSize="10" Margin="1,4,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="10,20,0,0"><TextBlock Text="本机专属虚拟机" Foreground="#9AABC8" FontSize="12"/><TextBlock Text="版本 0.4.0 · 本地运行" Foreground="#6E80A1" FontSize="11" Margin="0,6,0,0"/><Button Content="资源位置 / 修复" Click="Resources_Click" Margin="0,16,0,0" Padding="8,6" FontSize="12"/></StackPanel>
    <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation}" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="Workstation.Navigation">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="12,13"/><Setter Property="Foreground" Value="#BECBE1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="NavBody" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBody" Property="Background" Value="#293B67"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBody" Property="BorderBrush" Value="#5870A3"/><Setter TargetName="NavBody" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Width="28" FontSize="17"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,28,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding SectionTitle}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding SectionDescription}" Foreground="#6A768B" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding Serial}" Foreground="#778298" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Right"/></StackPanel>
   </Grid>
   <StackPanel Grid.Row="1">
    <Border Background="#FFF0F0" BorderBrush="#F2CBCB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Error}" Foreground="#9C3030" TextWrapping="Wrap"/></Border>
    <Expander x:Name="SessionExpander" Header="{Binding SessionHeadline}" Background="White" Padding="12" Margin="0,0,0,12" AutomationProperties.AutomationId="Session.Expander">
     <DockPanel><WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><Button Content="重新观察会话" Command="{Binding RefreshSessionCommand}" AutomationProperties.AutomationId="Session.Refresh"/><Button Content="继续原导入" Command="{Binding ResumeImportCommand}" AutomationProperties.AutomationId="Session.ResumeImport"/><Button Content="取消当前任务" Command="{Binding CancelSessionTaskCommand}"/><Button Content="打开会话产物" Click="OpenSessionRecords_Click"/></WrapPanel>
      <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SessionText}" TextWrapping="Wrap" FontSize="12" Foreground="#4A5872" AutomationProperties.AutomationId="Session.Summary"/></ScrollViewer>
     </DockPanel>
    </Expander>
   </StackPanel>
   <Grid Grid.Row="2">
    <Grid Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Android}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding Status}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" Foreground="#718097" Margin="0,6,0,0"/><WrapPanel Margin="0,13,0,0"><TextBlock Text="{Binding RootStatus}" Margin="0,0,20,0" Foreground="#167354"/><TextBlock Text="{Binding Display}" Foreground="#4A5872"/></WrapPanel></StackPanel>
      <StackPanel Grid.Column="1"><Button Content="打开安卓" Command="{Binding OpenAndroidCommand}" Style="{StaticResource AccentButton}" MinWidth="145" AutomationProperties.AutomationId="Android.Open"/><Button Content="保存并停止" Command="{Binding StopCommand}" AutomationProperties.AutomationId="Android.Stop"/></StackPanel>
     </Grid></Border>
     <Border Grid.Row="2" Background="#101826" CornerRadius="12"><Grid>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="安卓画面" Foreground="#BCC9DF" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="打开预览以观察，正常游玩请使用安卓窗口" Foreground="#70829E" Margin="0,10,0,0"/></StackPanel>
      <Image x:Name="PreviewImage" Stretch="Uniform" MouseMove="Preview_MouseMove" MouseLeftButtonDown="Preview_Down" MouseLeftButtonUp="Preview_Up" AutomationProperties.AutomationId="Android.Preview"/>
     </Grid></Border>
     <DockPanel Grid.Row="3" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><CheckBox Content="持续预览" IsChecked="{Binding PreviewEnabled}" VerticalAlignment="Center" Margin="0,0,16,8"/><Button Content="保存截图" Command="{Binding CaptureCommand}" AutomationProperties.AutomationId="Android.Capture"/><Button Content="唤醒" Command="{Binding WakeCommand}"/><Button Content="释放触点" Command="{Binding ReleaseCommand}"/></StackPanel><TextBlock x:Name="CoordinateText" Text="预览点击会在松开鼠标后发送" Foreground="#778297" VerticalAlignment="Center" FontSize="12"/></DockPanel>
    </Grid>
    <Grid Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Applications}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
     <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="已安装应用" Style="{StaticResource Heading}"/><Button Content="刷新列表" Command="{Binding RefreshApplicationsCommand}" HorizontalAlignment="Left"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBox Text="{Binding Package,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Applications.Package"/><WrapPanel><Button Content="打开应用" Command="{Binding LaunchCommand}" Style="{StaticResource AccentButton}"/><Button Content="停止应用" Command="{Binding StopApplicationCommand}"/><Button Content="卸载…" Click="Uninstall_Click"/></WrapPanel></StackPanel>
      <ListBox ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}" BorderBrush="#DEE4EF"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,12"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Package}" FontSize="11" Foreground="#78859A" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     </DockPanel>
     <StackPanel Grid.Column="2">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="安装或更新" Style="{StaticResource Heading}"/><TextBlock Text="保留应用数据；已安装的新版本不会被降级" Style="{StaticResource Label}"/><TextBox Text="{Binding ApkPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Applications.ApkPath"/><WrapPanel><Button Content="选择 APK…" Click="BrowseApk_Click"/><Button Content="安装并打开" Command="{Binding InstallCommand}" Style="{StaticResource AccentButton}" AutomationProperties.AutomationId="Applications.Install"/></WrapPanel><TextBlock Text="{Binding ApkSummary}" TextWrapping="Wrap" Foreground="#65738A" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Malody 皮肤与谱面" Style="{StaticResource Heading}"/><TextBlock Text="选择 MSP 或 MCZ，经应用自身导入。设备绑定皮肤需先正常登记。" TextWrapping="Wrap" Style="{StaticResource Label}"/><TextBox Text="{Binding ContentPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Applications.ContentPath"/><WrapPanel><Button Content="选择内容…" Click="BrowseContent_Click"/><Button Content="部署并重新加载" Command="{Binding ImportCommand}" Style="{StaticResource AccentButton}" AutomationProperties.AutomationId="Applications.Import"/></WrapPanel><TextBlock Text="完成后在 Malody 中确认启用；传输完成不代表已经可以游玩。" Foreground="#758298" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
     </StackPanel>
    </Grid>
    <DockPanel Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Files}">
     <StackPanel DockPanel.Dock="Top"><WrapPanel><ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" DisplayMemberPath="Title" Width="170"/><TextBox Text="{Binding Package,UpdateSourceTrigger=PropertyChanged}" Width="260"/><Button Content="停止应用" Command="{Binding StopApplicationCommand}"/></WrapPanel><DockPanel><Button Content="上一级" Command="{Binding ParentFolderCommand}" DockPanel.Dock="Left"/><Button Content="打开目录" Command="{Binding BrowseFilesCommand}" DockPanel.Dock="Right"/><TextBox Text="{Binding RemoteFolder,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Files.Path"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding BrowseFilesCommand}"/></TextBox.InputBindings></TextBox></DockPanel><TextBlock Text="私有数据可能包含账号与密钥。私有写入前请停止应用，导出后请妥善保管。" Foreground="#68758B" FontSize="12" Margin="0,2,0,12"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><WrapPanel><Button Content="上传文件…" Click="Upload_Click"/><Button Content="导出所选…" Click="Download_Click"/><Button Content="选择本地目录…" Click="BrowseSync_Click"/><Button Content="比较目录" Command="{Binding CompareCommand}"/><Button Content="同步变化文件" Command="{Binding SyncCommand}"/></WrapPanel><TextBox Text="{Binding LocalPath,UpdateSourceTrigger=PropertyChanged}" ToolTip="本地传输路径"/><TextBlock Text="覆盖前保留备份。同步保留目标额外文件。" Foreground="#758298" FontSize="12"/></StackPanel>
     <DataGrid ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" MouseDoubleClick="File_DoubleClick" AutomationProperties.AutomationId="Files.Table"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="90"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/><DataGridTextColumn Header="属主 / 权限" Binding="{Binding Permissions}" Width="170"/></DataGrid.Columns></DataGrid>
    </DockPanel>
    <DockPanel Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Diagnostics}">
     <StackPanel DockPanel.Dock="Top"><WrapPanel><TextBox Text="{Binding Package,UpdateSourceTrigger=PropertyChanged}" Width="260"/><TextBlock Text="秒" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBox Text="{Binding Seconds}" Width="65"/><Button Content="采集日志" Command="{Binding LogsCommand}" Style="{StaticResource AccentButton}"/><Button Content="内存 / CPU" Command="{Binding MetricsCommand}"/><Button Content="帧时序" Command="{Binding FrameSampleCommand}"/><Button Content="录屏 · 无音频" Command="{Binding RecordCommand}"/><Button Content="系统追踪" Command="{Binding TraceCommand}"/></WrapPanel><DockPanel><TextBlock Text="筛选" VerticalAlignment="Center" Margin="0,0,12,8" DockPanel.Dock="Left"/><TextBox Text="{Binding LogFilter,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Diagnostics.Filter"/></DockPanel></StackPanel>
     <TextBox Text="{Binding FilteredLogs,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#111B2D" Foreground="#C4D1E7" AutomationProperties.AutomationId="Diagnostics.Log"/>
    </DockPanel>
    <Grid Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Automation}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="同一套能力，窗口与 AI 共用" Style="{StaticResource Heading}"/><TextBlock Text="CLI 提供版本化 JSON、任务状态和取消。输入绑定当前会话与画面；不会自动选择 USB 设备。" TextWrapping="Wrap" Foreground="#68758B"/><WrapPanel Margin="0,14,0,0"><Button Content="CLI 调用说明" Click="OpenCliDocs_Click"/><Button Content="生成六指模板" Click="SixTouchTemplate_Click"/><Button Content="打开测试 JSON…" Click="OpenTest_Click"/><Button Content="运行请求" Command="{Binding RunTestCommand}" Style="{StaticResource AccentButton}"/></WrapPanel></StackPanel></Border>
     <TabControl Grid.Row="1"><TabItem Header="测试与输入"><TextBox Text="{Binding TestJson,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="10"/></TabItem>
      <TabItem Header="Shell"><DockPanel Margin="10"><WrapPanel DockPanel.Dock="Top"><Button Content="普通 Shell" Command="{Binding ShellCommand}"/><Button Content="Root Shell" Command="{Binding RootShellCommand}"/></WrapPanel><TextBox Text="{Binding Script,UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Top" Height="130" AcceptsReturn="True" FontFamily="Consolas"/><TextBox Text="{Binding RawResult,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/></DockPanel></TabItem>
      <TabItem Header="剪贴板与按键"><StackPanel Margin="18"><TextBlock Text="安卓剪贴板" Style="{StaticResource Heading}"/><TextBox Text="{Binding Clipboard,UpdateSourceTrigger=PropertyChanged}" Height="150" AcceptsReturn="True" TextWrapping="Wrap"/><WrapPanel><Button Content="写入安卓" Command="{Binding ClipboardWriteCommand}"/><Button Content="读取安卓" Command="{Binding ClipboardReadCommand}"/><Button Content="返回" Tag="KEYCODE_BACK" Click="AndroidKey_Click"/><Button Content="主页" Tag="KEYCODE_HOME" Click="AndroidKey_Click"/><Button Content="释放触点" Command="{Binding ReleaseCommand}"/></WrapPanel></StackPanel></TabItem>
     </TabControl>
    </Grid>
    <DockPanel Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Checkpoints}">
     <StackPanel DockPanel.Dock="Top"><WrapPanel><Button Content="停机并保存检查点" Command="{Binding CreateCheckpointCommand}" Style="{StaticResource AccentButton}"/><Button Content="刷新列表" Command="{Binding RefreshCheckpointsCommand}"/><Button Content="恢复所选" Click="Restore_Click"/><Button Content="恢复中断操作" Command="{Binding RecoverCommand}"/></WrapPanel><TextBlock Text="保存前会同步并停止安卓。恢复先验证文件，再暂存切换；原磁盘保留为回退副本。检查点可能包含密钥和登录状态。" TextWrapping="Wrap" Foreground="#68758B" Margin="0,4,0,16"/></StackPanel>
     <DataGrid ItemsSource="{Binding Checkpoints}" SelectedItem="{Binding SelectedCheckpoint}" AutomationProperties.AutomationId="Checkpoints.Table"><DataGrid.Columns><DataGridTextColumn Header="检查点编号" Binding="{Binding Id}" Width="270"/><DataGridTextColumn Header="本机位置" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Settings}">
     <StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="实际运行情况" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Display}" FontSize="19"/><TextBlock Text="{Binding Renderer}" Foreground="#68758B" Margin="0,8" TextWrapping="Wrap"/><TextBlock Text="{Binding HostMemory}" Foreground="#68758B"/><Button Content="重新检测" Command="{Binding RefreshRuntimeCommand}" HorizontalAlignment="Left" Margin="0,15,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel x:Name="RuntimeForm"><StackPanel.BindingGroup><BindingGroup NotifyOnValidationError="True"/></StackPanel.BindingGroup><TextBlock Text="显示与资源配置" Style="{StaticResource Heading}"/><TextBlock Text="更改在重新启动后生效。请求的刷新率与应用实际帧率分别验证。" Style="{StaticResource Label}"/>
       <WrapPanel><StackPanel Width="190"><TextBlock Text="图形后端" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Renderers}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding SelectedRenderer}"/></StackPanel><StackPanel Width="150"><TextBlock Text="刷新率" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding RefreshRate}"/></StackPanel><CheckBox Content="启用 Vulkan（需验证）" IsChecked="{Binding Vulkan}" VerticalAlignment="Center" Margin="16,16,0,0"/></WrapPanel>
       <WrapPanel><StackPanel Width="150"><TextBlock Text="宽度" Style="{StaticResource Label}"/><TextBox Text="{Binding Width,ValidatesOnExceptions=True}"/></StackPanel><StackPanel Width="150"><TextBlock Text="高度" Style="{StaticResource Label}"/><TextBox Text="{Binding Height,ValidatesOnExceptions=True}"/></StackPanel><StackPanel Width="150"><TextBlock Text="密度 DPI" Style="{StaticResource Label}"/><TextBox Text="{Binding Density,ValidatesOnExceptions=True}"/></StackPanel></WrapPanel>
       <WrapPanel><StackPanel Width="220"><TextBlock Text="安卓内存 MiB" Style="{StaticResource Label}"/><TextBox Text="{Binding MemoryMb,ValidatesOnExceptions=True}"/></StackPanel><StackPanel Width="180"><TextBlock Text="虚拟 CPU 核心" Style="{StaticResource Label}"/><TextBox Text="{Binding Cores,ValidatesOnExceptions=True}"/></StackPanel></WrapPanel>
       <StackPanel Width="300" HorizontalAlignment="Left"><TextBlock Text="启动时 Windows 可用内存 MiB" Style="{StaticResource Label}"/><TextBox Text="{Binding StartAvailableMb,ValidatesOnExceptions=True}"/><TextBlock Text="0 为自动；自定义最低 2560。运行期保护独立生效。" TextWrapping="Wrap" Foreground="#68758B"/></StackPanel>
       <CheckBox Content="低内存模式：允许较小安卓配额，需验证应用是否正常" IsChecked="{Binding LowRam}" Margin="0,8,0,8"/>
       <TextBlock Text="建议从 3072 MiB 开始。模拟器另有图形等开销；启动前检查系统余量，持续严重低内存时会保存并停止安卓。" Style="{StaticResource Label}" TextWrapping="Wrap"/>
       <CheckBox Content="桌面显示：移除模拟手机挖孔与外观" IsChecked="{Binding DesktopDisplay}" Margin="0,8,0,8"/><TextBlock Text="内存配额不是越大越快。为 Windows 留出余量，有助于避免换页和卡顿。" Foreground="#68758B" Margin="0,7,0,16" TextWrapping="Wrap"/>
       <WrapPanel><Button Content="填入推荐配置" Click="Recommended_Click"/><Button Content="保存并按需重启" Click="ApplyProfile_Click" Style="{StaticResource AccentButton}" AutomationProperties.AutomationId="Settings.Apply"/></WrapPanel>
      </StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="资源与维护" Style="{StaticResource Heading}"/><TextBlock Text="{Binding DataRoot}" TextWrapping="Wrap" Foreground="#68758B" Margin="0,0,0,14"/><WrapPanel><Button Content="资源位置与迁移" Click="Resources_Click"/><Button Content="修复运行环境" Click="Repair_Click"/></WrapPanel></StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <Expander Grid.Row="3" Header="任务与结果" Margin="0,18,0,0" Background="White" Padding="12" IsExpanded="False">
    <Grid MaxHeight="230"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Work}" SelectedItem="{Binding SelectedWork}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}"/><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#68758B"/><TextBlock Grid.Column="2" Text="{Binding Id}" FontSize="10" Foreground="#9AA4B5"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Column="1" Margin="12,0,0,0"><Button Content="取消所选任务" Command="{Binding CancelCommand}"/><Button Content="打开记录目录" Click="OpenRecords_Click"/><Button Content="查看详细结果" Click="ShowResult_Click"/></StackPanel></Grid>
   </Expander>
  </Grid>
 </Grid>
</Window>
